# 生产环境变量配置 - 部署前请修改以下值
#
# 单实例部署：直接复制本文件为 .env，执行 ./deploy.sh
# 多实例部署：为每个实例复制一份（如 .env.meal1、.env.meal2），
#   每个实例的端口、数据库密码、JWT 密钥必须互不相同，执行 ./deploy-instance.sh <实例名> <文件>

# 数据库密码（请设置强密码）
DB_ROOT_PASSWORD=your_strong_root_password_here
DB_USER=mealuser
DB_PASSWORD=your_strong_db_password_here

# JWT 密钥（请设置一个随机长字符串）
JWT_SECRET=your_random_jwt_secret_key_here

# 宿主机端口（多实例部署时每个实例必须不同，否则会端口冲突）
# FRONTEND_PORT=3000
# BACKEND_PORT=3001
