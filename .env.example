# 生产环境变量配置 - 部署前请修改以下值
#
# 单实例部署：直接复制本文件为 .env，执行 ./deploy.sh
# 多实例部署：为每个实例复制一份（如 .env.meal1、.env.meal2），
#   每个实例的端口、数据库密码、JWT 密钥必须互不相同，执行 ./deploy-instance.sh <实例名> <文件>

# 数据库密码（请设置强密码）
DB_ROOT_PASSWORD=your_strong_root_password_here
DB_USER=mealuser
DB_PASSWORD=your_strong_db_password_here

# JWT 密钥（请设置一个随机长字符串）
JWT_SECRET=your_random_jwt_secret_key_here

# 端口说明：生产模式前后端均不映射宿主机端口，对外访问由独立总反向代理
# 统一接管 80/443 并按二级域名转发（见仓库 reverse-proxy/ 目录）。
# 本地开发模式由 docker-compose.override.yml 自动映射 3000/3001，无需配置。
# 临时调试可在 docker-compose.yml 中手动加回 ports 映射。
# FRONTEND_PORT / BACKEND_PORT 已废弃，仅多实例旧脚本兼容保留注释
