# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Production build
# 不再忽略 build 产物：部署流程需要把 frontend/build 随代码一起推到 deploy 分支，
# 避免每次都要 git add -f 导致遗漏。dist 同理。
# frontend/build/
# frontend/dist/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
logs/
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Docker
# 注：docker-compose.override.yml 是本地热更新配置，不含敏感信息，
# 纳入版本管理以便 clone 后开箱即用热更新

# 反向代理证书私钥（绝不可提交到仓库！）
reverse-proxy/cert/*.crt
reverse-proxy/cert/*.key
reverse-proxy/cert/*.pem
!reverse-proxy/cert/.gitkeep

# Database
*.sql
!backend/init.sql
